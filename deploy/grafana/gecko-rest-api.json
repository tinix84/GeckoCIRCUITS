{
  "title": "GeckoCIRCUITS REST API",
  "uid": "gecko-rest-api",
  "schemaVersion": 39,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Simulation throughput",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$prometheus"
          },
          "expr": "sum by (status) (rate(gecko_simulations_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Simulation duration p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gecko_simulation_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "title": "Simulation error rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$prometheus"
          },
          "expr": "sum(rate(gecko_simulations_total{status=\"FAILED\"}[5m])) / clamp_min(sum(rate(gecko_simulations_total[5m])), 1e-9)",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "id": 4,
      "title": "Simulation queue depth",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$prometheus"
          },
          "expr": "sum(gecko_simulation_queue_depth)",
          "legendFormat": "queued"
        }
      ]
    }
  ]
}
